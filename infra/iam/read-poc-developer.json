{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyUsEast1AndUsWest2",
      "Effect": "Deny",
      "NotAction": ["iam:*", "sts:*"],
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["us-east-1", "us-west-2"]}}
    },
    {
      "Sid": "UsWest2OnlyForRerank",
      "Effect": "Deny",
      "NotAction": ["bedrock:Rerank", "bedrock:InvokeModel", "bedrock:ListFoundationModels", "bedrock:GetFoundationModel", "iam:*", "sts:*"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}
    },
    {
      "Sid": "Bedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0"
      ]
    },
    {
      "Sid": "RerankApiUsWest2",
      "Effect": "Allow",
      "Action": "bedrock:Rerank",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}
    },
    {
      "Sid": "AmazonRerankModelOnly",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-west-2::foundation-model/amazon.rerank-v1:0"
    },
    {
      "Sid": "BedrockRead",
      "Effect": "Allow",
      "Action": ["bedrock:ListFoundationModels", "bedrock:GetFoundationModel", "bedrock:ListInferenceProfiles"],
      "Resource": "*"
    },
    {
      "Sid": "OpenSearchServerless",
      "Effect": "Allow",
      "Action": [
        "aoss:CreateCollection", "aoss:DeleteCollection", "aoss:UpdateCollection", "aoss:BatchGetCollection", "aoss:ListCollections",
        "aoss:CreateSecurityPolicy", "aoss:GetSecurityPolicy", "aoss:UpdateSecurityPolicy", "aoss:DeleteSecurityPolicy", "aoss:ListSecurityPolicies",
        "aoss:CreateAccessPolicy", "aoss:GetAccessPolicy", "aoss:UpdateAccessPolicy", "aoss:DeleteAccessPolicy", "aoss:ListAccessPolicies",
        "aoss:APIAccessAll"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AossServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {"StringEquals": {"iam:AWSServiceName": "observability.aoss.amazonaws.com"}}
    },
    {
      "Sid": "ProjectData",
      "Effect": "Allow",
      "Action": ["s3:*", "dynamodb:*"],
      "Resource": [
        "arn:aws:s3:::read-poc-*",
        "arn:aws:s3:::aws-sam-cli-managed-default-*",
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/read-poc-*"
      ]
    },
    {
      "Sid": "SamDeploy",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:us-east-1:ACCOUNT_ID:stack/read-poc*/*",
        "arn:aws:cloudformation:us-east-1:ACCOUNT_ID:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "CfnRead",
      "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:ListStacks"],
      "Resource": "*"
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:read-poc-*"
    },
    {
      "Sid": "HttpApi",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:us-east-1::/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/read-poc-*"
    },
    {
      "Sid": "RolesOnlyWithBoundary",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:DeleteRolePolicy"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/read-poc-*",
      "Condition": {"StringEquals": {"iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/read-poc-boundary"}}
    },
    {
      "Sid": "RoleHousekeeping",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies",
        "iam:TagRole", "iam:UntagRole", "iam:DeleteRole", "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/read-poc-*"
    },
    {
      "Sid": "PassOnlyToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/read-poc-*",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    },
    {
      "Sid": "NoBoundaryEscape",
      "Effect": "Deny",
      "Action": ["iam:DeleteRolePermissionsBoundary", "iam:CreatePolicyVersion", "iam:DeletePolicy", "iam:SetDefaultPolicyVersion"],
      "Resource": "*"
    },
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
